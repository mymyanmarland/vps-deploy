# kmnapps.xyz - reverse proxy for all apps (HTTP; certbot --nginx adds SSL later)
# Each app: standard proxy headers + websocket support + generous timeouts for AI calls

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ---------- shared proxy defaults ----------
# (included inline per server via copy-paste to keep this file self-contained)

# ---------- apex: landing page ----------
server {
    listen 80;
    server_name kmnapps.xyz;
    root /var/www/kmnapps.xyz;
    index index.html;
    location / { try_files $uri $uri/ =404; }
}

server {
    listen 80;
    server_name www.kmnapps.xyz;
    return 301 https://kmnapps.xyz$request_uri;
}

# ---------- money tracker (3001) ----------
server {
    listen 80;
    server_name money.kmnapps.xyz;
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_connect_timeout 10s;
    }
}

